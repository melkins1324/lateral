# Copy to .env (never commit .env). Names only — no values here.
# On a Mac, prefer the Keychain (see README) over putting the token in a file.
NOTION_TOKEN=
# Second Brain 2.0 › Everything data source (not secret; default is built in)
NOTION_DATA_SOURCE_ID=923ba32e-04e8-4c61-bf44-43093e061c0a
# Optional tuning
SB_TIMEOUT=20
SB_ATTEMPTS=4
SB_HOME=~/.second-brain

